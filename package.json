{
  "name": "adapt-mediaGallery",
  "repository": {
    "type": "git",
    "url": "git://github.com/cgkineo/adapt-mediaGallery.git"
  },
  "framework": ">=5.8",
  "version": "1.1.0",
  "homepage": "https://github.com/cgkineo/adapt-mediaGallery",
  "issues": "https://github.com/cgkineo/adapt-mediaGallery/issues",
  "component": "mediagallery",
  "displayName": "Media Gallery",
  "description": "Extends the functionality of adapt-contrib-media by providing a gallery of videos",
  "main": "/js/adapt-mediaGallery.js",
  "keywords": [
    "adapt-plugin",
    "adapt-component"
  ],
  "pluginDependencies": {
    "adapt-contrib-media": ">=5.1"
  },
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "postversion": "cp package.json bower.json"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.5",
    "@semantic-release/npm": "^9.0.1",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "conventional-changelog-eslint": "^3.0.9",
    "semantic-release": "^19.0.3"
  },
  "release": {
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "eslint"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "eslint"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "bower.json"
          ],
          "message": "Chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
