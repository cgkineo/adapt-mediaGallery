{
  "name": "adapt-mediaGallery",
  "repository": {
    "type": "git",
    "url": "git://github.com/cgkineo/adapt-mediaGallery.git"
  },
  "framework": ">=5.14.0",
  "version": "1.1.1",
  "homepage": "https://github.com/cgkineo/adapt-mediaGallery",
  "issues": "https://github.com/cgkineo/adapt-mediaGallery/issues",
  "component": "mediagallery",
  "displayName": "Media Gallery",
  "description": "Extends the functionality of adapt-contrib-media by providing a gallery of videos",
  "main": "/js/adapt-mediaGallery.js",
  "keywords": [
    "adapt-plugin",
    "adapt-component"
  ],
  "pluginDependencies": {
    "adapt-contrib-media": ">=5.1"
  },
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "postversion": "cp package.json bower.json"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-eslint": "^6.0.0",
    "semantic-release": "^25.0.2",
    "semantic-release-replace-plugin": "^1.2.7"
  },
  "release": {
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "eslint"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "eslint"
        }
      ],
      [
        "semantic-release-replace-plugin",
        {
          "replacements": [
            {
              "files": "migrations/*.js",
              "from": "@@CURRENT_VERSION",
              "to": "${lastRelease.version}",
              "countMatches": true,
              "allowEmptyPaths": true
            },
            {
              "files": "migrations/*.js",
              "from": "@@RELEASE_VERSION",
              "to": "${nextRelease.version}",
              "countMatches": true,
              "allowEmptyPaths": true
            }
          ]
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "bower.json",
            "migrations/*.js"
          ],
          "message": "Chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
